{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".oxlintrc.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "lib/**",
        "dist/**"
      ]
    },
    "compile": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "lib/**",
        ".jsii"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "package": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "clobber": {
      "cache": false
    }
  }
}
