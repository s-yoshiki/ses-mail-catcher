{
  "name": "ses-mail-catcher-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "compile": "turbo run compile",
    "typecheck": "turbo run typecheck",
    "package": "turbo run package",
    "clean": "node scripts/clean.mjs",
    "projen": "pnpm --filter @s-yoshiki/cdk-ses-mail-catcher projen",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
