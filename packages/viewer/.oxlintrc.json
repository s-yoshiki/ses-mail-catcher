{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "oxc",
    "typescript",
    "unicorn",
    "import",
    "vitest",
    "react"
  ],
  "env": {
    "browser": true,
    "vitest": true
  },
  "categories": {
    "correctness": "deny",
    "suspicious": "deny"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  }
}
